<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings"
    style="@style/LinearLayoutStyle">

    <LinearLayout style="@style/LinearLayoutHeadStyle">

        <ImageButton
            android:id="@+id/back"
            style="@style/ImageButtonBackStyle" />

        <TextView
            style="@style/TextViewHeadStyle"
            android:text="@string/settings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/half">

        <LinearLayout
            android:id="@+id/theme"
            style="@style/LinearLayoutListStyle">

            <TextView
                style="@style/TextViewStyle"
                android:text="@string/dark_theme" />

            <Switch
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:theme="@style/Switch" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/share"
            style="@style/LinearLayoutListStyle">

            <TextView
                style="@style/TextViewStyle"
                android:text="@string/to_share" />

            <ImageView
                style="@style/ImageViewSettingsLayoutStyle"
                android:src="@drawable/ic_share" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/support"
            style="@style/LinearLayoutListStyle">

            <TextView
                style="@style/TextViewStyle"
                android:text="@string/to_support" />

            <ImageView
                style="@style/ImageViewSettingsLayoutStyle"
                android:src="@drawable/ic_support" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/userAgreement"
            style="@style/LinearLayoutListStyle">

            <TextView
                style="@style/TextViewStyle"
                android:text="@string/user_agreement" />

            <ImageView
                style="@style/ImageViewSettingsLayoutStyle"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>