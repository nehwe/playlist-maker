<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    android:id="@+id/settings"
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/LinearLayoutStyle">

    <LinearLayout
        style="@style/LinearLayoutHeadStyle">

        <ImageButton
            android:id="@+id/back"
            style="@style/ImageButtonBackStyle"/>

        <TextView
            android:text="@string/settings"
            style="@style/TextViewHeadStyle"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/layout_margin">

        <LinearLayout
            android:id="@+id/theme"
            style="@style/LinearLayoutListStyle">

            <TextView
                android:text="@string/dark_theme"
                style="@style/TextViewStyle" />

            <Switch
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:theme="@style/Switch"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/share"
            style="@style/LinearLayoutListStyle">

            <TextView
                android:text="@string/to_share"
                style="@style/TextViewStyle" />

            <ImageView
                android:src="@drawable/ic_share"
                style="@style/ImageViewSettingsLayoutStyle"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/support"
            style="@style/LinearLayoutListStyle">

            <TextView
                android:text="@string/to_support"
                style="@style/TextViewStyle"
                />

            <ImageView
                android:src="@drawable/ic_support"
                style="@style/ImageViewSettingsLayoutStyle"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/userAgreement"
            style="@style/LinearLayoutListStyle">

            <TextView
                android:text="@string/user_agreement"
                style="@style/TextViewStyle"/>

            <ImageView
                android:src="@drawable/ic_chevron_right"
                style="@style/ImageViewSettingsLayoutStyle"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>