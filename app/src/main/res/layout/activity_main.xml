<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    style="@style/LinearLayoutStyle"
    android:background="?attr/colorSecondaryVariant">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginHorizontal="@dimen/half"
        android:layout_marginTop="@dimen/half"
        android:layout_marginBottom="@dimen/padding_end"
        android:fontFamily="@font/ys_display_medium"
        android:text="@string/app_name"
        android:textColor="@color/yp_white"
        android:textFontWeight="@integer/font_weight_head"
        android:textSize="@dimen/title_text_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/half"
        android:layout_marginTop="@dimen/zero"
        android:layout_marginBottom="@dimen/half"
        android:orientation="vertical">

        <Button
            android:id="@+id/search"
            style="@style/ButtonStyle"
            android:fontFamily="@font/ys_display_medium"
            android:text="@string/search"
            app:icon="@drawable/search" />

        <Button
            android:id="@+id/library"
            style="@style/ButtonStyle"
            android:text="@string/media_library"
            app:icon="@drawable/library" />

        <Button
            android:id="@+id/settings"
            style="@style/ButtonStyle"
            android:text="@string/settings"
            app:icon="@drawable/settings" />

    </LinearLayout>
</LinearLayout>