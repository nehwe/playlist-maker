<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search"
    style="@style/LinearLayoutStyle">

    <LinearLayout style="@style/LinearLayoutHeadStyle">

        <ImageButton
            android:id="@+id/back"
            style="@style/ImageButtonBackStyle" />

        <TextView
            style="@style/TextViewHeadStyle"
            android:text="@string/search" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/half"
        android:layout_marginTop="@dimen/quarter">

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/whole"

            android:background="@drawable/bg_search_input"
            android:drawableStart="@drawable/search"
            android:drawablePadding="@dimen/quarter"
            android:drawableTint="?attr/colorOnSurface"

            android:gravity="center_vertical"
            android:hint="@string/search"
            android:imeOptions="actionSearch"

            android:inputType="textFilter"
            android:maxLines="@integer/unit"

            android:paddingHorizontal="@dimen/padding_inner"
            android:paddingStart="@dimen/padding_inner"

            android:paddingEnd="@dimen/padding_end"
            android:textColor="?attr/colorAccent"
            android:textColorHint="?attr/colorOnSurface"
            android:textSize="@dimen/body" />

        <ImageView
            android:id="@+id/clearIcon"
            android:layout_width="@dimen/half"
            android:layout_height="@dimen/half"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/padding_inner"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_clear"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:visibility="gone"
            app:tint="?attr/colorOnSurface" />
    </FrameLayout>
</LinearLayout>